generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  phone     String?    @unique
  password  String?
  nickname  String?
  avatar    String?
  aiCount   Int        @default(0) // AI 规划使用次数
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  trips     Trip[]
  favorites Favorite[]
}

// 行程
model Trip {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  destination String
  startDate   DateTime?
  endDate     DateTime?
  days        Int        @default(1)
  budget      Float?
  isPublic    Boolean    @default(false)
  source      String     @default("manual") // manual | ai | template
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  steps       TripStep[]
  favorites   Favorite[]
}

// 行程步骤（时间轴卡片）
model TripStep {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day         Int      @default(1)
  order       Int      @default(0)
  // transport_main | transport_transfer | hotel | ticket | food | sight | other
  type        String
  title       String
  startTime   String? // "07:00"
  endTime     String?
  durationMin Int?
  cost        Float?
  details     Json? // 各类型可配置字段
  createdAt   DateTime @default(now())
}

// 行程模板
model Template {
  id          String   @id @default(cuid())
  title       String
  destination String
  days        Int
  description String?
  tags        String   @default("[]")
  coverColor  String   @default("#16a34a")
  steps       Json // 步骤快照 [{type,title,startTime,cost,details,...}]
  isOfficial  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 收藏
model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
}
